# 自建 Dify 请改为可从网站服务器访问的 Service API 地址，包含 /v1。
DIFY_API_BASE_URL=https://api.dify.ai/v1
# 导入 00-shared-toolkit.yml，配置模型并发布后填写该应用 API Key，一次接通全部工具。
# 不要填模型供应商 API Key。密钥只在服务器读取。
DIFY_API_KEY=
# 可选：01–10 各自独立配置，单工具密钥优先于统一入口密钥。
DIFY_KEY_STORE_SCRIPT=
DIFY_KEY_FACTORY_SCRIPT=
DIFY_KEY_SOCIAL_COPY=
DIFY_KEY_VIDEO_TOPICS=
DIFY_KEY_PRODUCT_BENEFITS=
DIFY_KEY_CUSTOMER_REPLY=
DIFY_KEY_SALES_FOLLOWUP=
DIFY_KEY_MEETING_NOTES=
DIFY_KEY_WEEKLY_REPORT=
DIFY_KEY_DATA_EXTRACTOR=
